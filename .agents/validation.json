{
  "version": 1,
  "timeout_seconds": 1800,
  "profiles": {
    "python": {
      "paths": [
        "*.py",
        "scripts/contribution-requirements.txt",
        ".agents/ruff.toml"
      ]
    },
    "swift": {
      "paths": [
        "Sources/*",
        "Tests/*",
        "Packages/*",
        "Plugins/*",
        "Package.swift",
        "Package.resolved",
        ".swiftlint.yml"
      ]
    },
    "client": {
      "paths": [
        "Apps/Client/*",
        "Sources/Protocols/*",
        "Sources/PluginSDK/*",
        "Sources/SloppySDK/*",
        "Packages/SloppyComputerControl/*",
        "Package.swift",
        "Package.resolved",
        ".swiftlint.yml"
      ]
    },
    "dashboard": {
      "paths": [
        "Dashboard/*",
        "Sources/Protocols/API/*"
      ]
    },
    "docs": {
      "paths": [
        "docs/*"
      ]
    },
    "platform": {
      "paths": [
        "Sources/*",
        "Packages/*",
        "Plugins/*",
        "Package.swift",
        "Package.resolved",
        "Apps/Client/*",
        "ClientNative/*"
      ]
    },
    "documentation": {
      "paths": [
        "*.md",
        ".agents/skills/*"
      ]
    },
    "workflow": {
      "paths": [
        ".agents/validation.json",
        ".agents/ruff.toml",
        ".agents/secret-exceptions.json",
        ".swiftlint.yml",
        "scripts/contribution/*",
        "scripts/check_contribution.py",
        "scripts/test_contribution.py",
        "scripts/test_publication.py",
        "scripts/contribution-requirements.txt",
        ".github/workflows/contributor-validation.yml"
      ]
    },
    "native_client": {
      "paths": [
        "ClientNative/*",
        "Packages/*",
        ".swiftlint.yml"
      ]
    }
  },
  "python_suites": {
    "scripts/contribution/*": [
      "scripts/test_contribution.py",
      "scripts/test_publication.py"
    ],
    "scripts/check_contribution.py": [
      "scripts/test_contribution.py",
      "scripts/test_publication.py"
    ]
  },
  "runtime_paths": [
    "Dashboard/src/*",
    "Sources/sloppy/Gateway/*",
    "Sources/NodeCore/*",
    "Apps/Client/Sources/*",
    "ClientNative/Sources/*"
  ],
  "dependency_paths": [
    "*Package.swift",
    "*Package.resolved",
    "*package.json",
    "*package-lock.json",
    "*requirements*.txt"
  ],
  "swift_scratch": ".artifacts/contribution/swift-build",
  "user_documentation_roots": [
    "docs/*.md"
  ],
  "internal_documentation_roots": [
    "docs/designs/*",
    "docs/plans/*",
    "docs/specs/*",
    "docs/product/*",
    "docs/architecture/*",
    "docs/superpowers/*",
    "docs/tbd/*",
    "docs/legal/*",
    "Apps/docs/*"
  ],
  "commands": {
    "runtime": null,
    "platform": null,
    "dependency": null
  },
  "pre_push": {
    "base_ref": "refs/remotes/origin/main",
    "ci_checks": {
      "swift-lint": {
        "targets": [
          {
            "workflow": ".github/workflows/contributor-validation.yml",
            "job": "swift"
